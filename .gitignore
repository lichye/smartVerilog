# Local toolchains, fixed mutants, and research data. These are intentionally
# outside the source release; never replace this list with a broad git-clean.
/otherTools/
/MutationBenchmark/
/Results/
/CaseStudy/
/artifact/
/Docker/artifact/
/fmsdArtifact/

# `tiny_and` is the shipped smoke fixture. Other user experiments are local
# inputs, not accidental additions to the public benchmark corpus.
/Benchmark/user/*
!/Benchmark/user/tiny_and/
!/Benchmark/user/tiny_and/**

# Build, smoke, and pipeline scratch output.
/build/
/dist/
/smoke-out/
/smart/build/
/smart/runtime/
/smart/benchmarks/
/smart/sim_build/
/smart/result/
/smart/user/
/smart/smart.out
smart-work-*/
**/sim_build/

# Python/tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local editor and agent state.
/.codex/
/.claude/
/.vscode/
/.idea/
.DS_Store
*~
*.orig
*.rej
